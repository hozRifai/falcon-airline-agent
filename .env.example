# ---- Falcon Airline agent: environment ----
# Copy to .env and fill in. Every service reads this file (pydantic-settings).

# Frozen clock. All deadline rules, seeds and evaluation runs use this "now", never the wall clock.
FALCON_NOW=2026-10-20T09:00:00+04:00

# ---- Postgres (one instance, one schema + one role per system) ----
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=falcon
PGADMIN_USER=postgres
PGADMIN_PASSWORD=falcon_super
# Service roles (least privilege; created by db/schema.sql)
PG_RES_PASSWORD=res_rw_pw
PG_OPSAPI_PASSWORD=ops_api_pw
PG_POLICY_PASSWORD=policy_ro_pw
PG_AGENT_PASSWORD=agent_rw_pw
PG_AUDIT_PASSWORD=audit_w_pw

# ---- Auth between the runtime and the MCP servers ----
# dev   = HS256 tokens minted by the runtime with FALCON_DEV_SECRET (local and demo)
# entra = Microsoft Entra ID app-only tokens (JWKS validation; ENTRA_TENANT_ID and the app registrations' client ids)
AUTH_MODE=dev
FALCON_DEV_SECRET=change-me-dev-secret-32-chars-minimum
ENTRA_TENANT_ID=
ENTRA_RUNTIME_CLIENT_ID=
ENTRA_AUD_RESERVATIONS=api://falcon-reservations
ENTRA_AUD_FLIGHTOPS=api://falcon-flightops
ENTRA_AUD_POLICY=api://falcon-policy

# ---- Service URLs ----
LEGACY_API_URL=http://127.0.0.1:8010
LEGACY_API_KEY=legacy-dev-key
MCP_RESERVATIONS_URL=http://127.0.0.1:8001/mcp
MCP_FLIGHTOPS_URL=http://127.0.0.1:8002/mcp
MCP_POLICY_URL=http://127.0.0.1:8003/mcp
RUNTIME_PUBLIC_URL=http://127.0.0.1:8000

# ---- Models via OpenRouter (OpenAI-compatible) ----
# Model ids are OpenRouter ids (https://openrouter.ai/models). DeepSeek V4.1 Flash 1017 is the agent, the cheap
# comparison and the simulated user: tool calling works and a full evaluation run costs cents. bge-m3 embeds Arabic
# and English into one 1024-dim space (used only when you run `scripts/ingest_policy.py --embed`).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter            # openrouter | anthropic | fake
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_MODEL_CHEAP=deepseek/deepseek-v4.1-flash-1017
SIMULATOR_MODEL=deepseek/deepseek-chat   # the simulated customer: a different model from the agent (decision #44)
EMBEDDING_PROVIDER=openrouter      # openrouter | none
EMBEDDING_MODEL=baai/bge-m3
# Prices used by the evaluation's cost metrics (USD per million tokens); update if the model changes
LLM_PRICE_IN_PER_M=0.15
LLM_PRICE_OUT_PER_M=0.60
# Reviewer loop: every draft reply is checked against the tool trace (amounts, action claims, policy sources) and sent back to
# the model with the exact problem, up to REVIEW_MAX_ROUNDS times, then a safe "could not resolve" message. REVIEW_LLM=true adds
# a model reviewer (REVIEW_MODEL) on top of the deterministic checks: one more model call per reply, about 3-5 s.
REVIEW_MAX_ROUNDS=3
REVIEW_LLM=false
REVIEW_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional direct providers
ANTHROPIC_API_KEY=

# ---- Tracing (decision #27: OpenTelemetry once, any backend) ----
# Empty = off. Local trace UI: `scripts/up.sh --trace` (starts Phoenix and sets this to http://phoenix:6006 for the containers).
# Langfuse: OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel and
#           OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ENVIRONMENT=demo

# ---- Demo protection ----
DEMO_ACCESS_CODE=            # empty: no code; set one only for a public deployment
RATE_LIMIT_PER_MINUTE=30
MAX_TURNS_PER_SESSION=40
MAX_TOOL_CALLS_PER_TURN=8
DAILY_TOKEN_BUDGET=2000000
ADMIN_TOKEN=change-me-admin
