# ---- Falcon Airline agent: environment ----
# Copy to .env and fill in. Every service reads this file (pydantic-settings); the defaults work locally.

# Frozen clock. All deadline rules, seeds and evaluation runs use this "now", never the wall clock.
FALCON_NOW=2026-10-23T09:00:00+04:00

# ---- Postgres (one instance, one schema + one role per system) ----
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=falcon
PGADMIN_USER=postgres
PGADMIN_PASSWORD=falcon_super
# Service roles (least privilege; created by db/schema.sql)
PG_RES_PASSWORD=res_rw_pw
PG_OPSAPI_PASSWORD=ops_api_pw
PG_POLICY_PASSWORD=policy_ro_pw
PG_AGENT_PASSWORD=agent_rw_pw
PG_AUDIT_PASSWORD=audit_w_pw

# ---- Tokens: browser <-> runtime <-> MCP servers (HS256 with this secret; core/auth.py) ----
FALCON_DEV_SECRET=change-me-dev-secret-32-chars-minimum
ADMIN_TOKEN=change-me-admin         # the evaluation harness and scripts/talk.py: full tool results in the done event

# ---- Service URLs ----
LEGACY_API_URL=http://127.0.0.1:8010
LEGACY_API_KEY=legacy-dev-key
MCP_RESERVATIONS_URL=http://127.0.0.1:8001/mcp
MCP_FLIGHTOPS_URL=http://127.0.0.1:8002/mcp
MCP_POLICY_URL=http://127.0.0.1:8003/mcp
RUNTIME_PUBLIC_URL=http://127.0.0.1:8000

# ---- Models via OpenRouter (OpenAI-compatible; ids from https://openrouter.ai/models) ----
# No key: the scripted stand-in model runs every flow. One model for the agent, the guard classifier, the query rewriter and the
# citation check (decision #44); the simulated customer and the generation judge are different models on purpose.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter            # openrouter | fake
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
SIMULATOR_MODEL=deepseek/deepseek-chat
JUDGE_MODEL=qwen/qwen3-235b-a22b-2507
EMBEDDING_PROVIDER=openrouter      # openrouter | none
EMBEDDING_MODEL=baai/bge-m3
# Prices used by the evaluation's cost metrics (USD per million tokens); update if the model changes
LLM_PRICE_IN_PER_M=0.15
LLM_PRICE_OUT_PER_M=0.60

# ---- The agent loop ----
REVIEW_MAX_ROUNDS=3                # a rejected draft goes back to the model this many times, then the reply is held
REVIEW_CITATIONS=true              # one model call per reply that cites a clause: the clause text against the sentence citing it
MAX_TOOL_CALLS_PER_TURN=8
DAILY_TOKEN_BUDGET=2000000         # the demo's spend cap: /api/chat answers 429 once the day's tokens are spent

# ---- Tracing (decision #27: OpenTelemetry once, any backend) ----
# Empty = off. Local trace UI: `scripts/up.sh --trace` (starts Phoenix and sets this to http://phoenix:6006 for the containers).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ---- Voice channel (optional; scripts/up.sh --voice starts the Pipecat bot on http://localhost:7860) ----
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# VOICE_TURN_PAUSE=1.5          # seconds of silence that end the customer's turn
# ELEVENLABS_VOICE_AR= / ELEVENLABS_VOICE_EN=   # voice ids (a library voice must be added to the account first)
